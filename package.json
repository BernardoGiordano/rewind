{
  "name": "rewind",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env --watch --experimental-strip-types --no-warnings=ExperimentalWarning server/server.ts",
    "dev:web": "srl serve --app web --proxy /api=http://localhost:4000",
    "build": "npm run build:web && npm run build:server",
    "build:web": "srl build --app web --out dist/web",
    "build:server": "tsc -p server",
    "start": "node --env-file-if-exists=.env dist/server/server.js",
    "check": "srl check && tsc -p server --noEmit",
    "test": "vitest run tests/",
    "test:server": "vitest run tests/library.test.ts"
  },
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@srljs/cli": "file:../srl/cli",
    "@srljs/core": "file:../srl/source",
    "@tailwindcss/cli": "4.3.3",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
